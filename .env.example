# GCP Configuration
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
BUCKET_NAME="your-gcs-bucket-name"

# Google Sheets
GOOGLE_SHEET_ID="your-google-sheet-id"
# For local dev, point to the service account key. On GCP, use Workload Identity.
SERVICE_ACCOUNT_FILE="path/to/your/service-account.json"

# LLM Configuration
LLM_PROVIDER="vertex"
VERTEX_MODEL_NAME="gemini-1.5-flash-001"   # For Extraction
VERTEX_PRO_MODEL_NAME="gemini-1.5-pro-001" # For Analysis

# API Configuration
ALLOWED_ORIGINS="*"

# Worker Configuration
TEMPERATURE="0.1"