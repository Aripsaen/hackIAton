# Set to "production" to use Google Cloud Storage, otherwise uses local mock storage.
ENV=development

# Your Google Cloud Project ID (only needed for production)
GCP_PROJECT_ID="your-gcp-project-id"

# The GCS bucket name to use (only needed for production)
GCS_BUCKET_NAME="your-gcs-bucket-name"

# Your Google API Key for Gemini Models
GOOGLE_API_KEY="your-google-api-key"

# LLM Configuration
# Set to "gemini" or "openai"
LLM_PROVIDER="gemini"

# Your Google API Key for Gemini Models (if LLM_PROVIDER is "gemini")
GOOGLE_API_KEY="your-google-api-key"

# Your OpenAI API Key (if LLM_PROVIDER is "openai")
# OPENAI_API_KEY="your-openai-api-key"

# Model names. These will be used based on the LLM_PROVIDER setting.
# For Gemini:
EXTRACTION_MODEL_NAME="gemini-1.5-flash"
ANALYSIS_MODEL_NAME="gemini-1.5-pro"

# For OpenAI (uncomment and set if using OpenAI):
# EXTRACTION_MODEL_NAME_OPENAI="gpt-3.5-turbo"
# ANALYSIS_MODEL_NAME_OPENAI="gpt-4o"
