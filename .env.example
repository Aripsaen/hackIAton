# GCP Configuration
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
BUCKET_NAME="your-gcs-bucket-name"

# Google Sheets
GOOGLE_SHEET_ID="your-google-sheet-id"
# For local dev, point to the service account key. On GCP, use Workload Identity.
SERVICE_ACCOUNT_FILE="path/to/your/service-account.json"

# LLM Configuration
LLM_PROVIDER="vertex" # or "openai"
VERTEX_MODEL_NAME="gemini-1.5-flash-001"
# OPENAI_API_KEY="your-openai-api-key" # Required if LLM_PROVIDER is "openai"
# OPENAI_MODEL_NAME="gpt-4o"

# API Configuration
ALLOWED_ORIGINS="*" # Comma-separated list of allowed origins for CORS

# Worker Configuration
TEMPERATURE="0.1"
